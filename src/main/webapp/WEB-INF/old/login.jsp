<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<html>
<head>
    <title>Login</title>
</head>
<body>
<form method="post">
    <div>
        <label for="login">Login</label>
        <input type="text" id="login" name="login"/>
    </div>
