<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet author="ikazakov" id="add-fk-constraint-to-answer-result">
        <addForeignKeyConstraint baseTableSchemaName="quests"
                                 baseTableName="answer_result"
                                 baseColumnNames="answer_id"
                                 referencedTableSchemaName="quests"
                                 referencedTableName="answer"
                                 referencedColumnNames="id"
                                 constraintName="fk_answer_result_answer"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="quests"
                                 baseTableName="answer_result"
                                 baseColumnNames="result_id"
                                 referencedTableSchemaName="quests"
                                 referencedTableName="result"
                                 referencedColumnNames="id"
                                 constraintName="fk_answer_result_result"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>